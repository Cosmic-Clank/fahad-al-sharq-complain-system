// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id    Int     @id @default(autoincrement())
  username String  @unique
  passwordHash String
  fullName  String
  role Role @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  complaintResponses ComplaintResponse[]
  workTimes WorkTimes[]
  complaintsAssigned Complaint[] @relation("AssignedComplaints")
  inventoryRequests InventoryRequest[]
  inventoryTransactions InventoryTransaction[]
  approvedRequests InventoryRequest[] @relation("ApprovedRequests")
  employeeInventory EmployeeInventory[] @relation("EmployeeInventoryItems")
  inventoryUsages ComplaintInventoryUsage[] @relation("EmployeeInventoryUsages")
  employeeProfile EmployeeProfile?
  attendanceRecords AttendanceRecord[]
  employeeDocuments EmployeeDocument[]
  airlineTickets AirlineTicket[]
  penalties Penalty[]
  bonuses Bonus[]
  passportHandovers PassportHandover[]
  activityLogsAuthored ActivityLog[] @relation("ActivityLogsAuthored")
  activityLogsAbout ActivityLog[] @relation("ActivityLogsAbout")
}

enum Role {
  EMPLOYEE
  ADMIN
  INVENTORY_MANAGER
  HR_MANAGER
}

enum ConvenientTime {
  EIGHT_AM_TO_TEN_AM
  TEN_AM_TO_TWELVE_PM
  TWELVE_PM_TO_TWO_PM
  TWO_PM_TO_FOUR_PM
  FOUR_PM_TO_SIX_PM
  SIX_PM_TO_EIGHT_PM
  EIGHT_PM_TO_TEN_PM
  TEN_PM_TO_TWELVE_AM
  TWELVE_AM_TO_TWO_AM
  TWO_AM_TO_FOUR_AM
  FOUR_AM_TO_SIX_AM
  SIX_AM_TO_EIGHT_AM
}


model Complaint {
  id              Int      @id @default(autoincrement())
  customerName    String
  customerEmail   String?
  isPrivate       Boolean?
  customerPhone   String
  customerAddress String
  buildingName    String
  apartmentNumber String // Optional field for apartment number
  description     String
  imagePaths      String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  assignedToId   Int?

  convenientTime ConvenientTime // Default value for convenient time

  responses       ComplaintResponse[]
  workTimes       WorkTimes[]
  assignedTo      User? @relation("AssignedComplaints", fields: [assignedToId], references: [id], onDelete: SetNull)
  inventoryUsages ComplaintInventoryUsage[]
}

model ComplaintResponse {
  id          Int      @id @default(autoincrement())
  complaintId Int
  response    String
  responderId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imagePaths  String[]

  responder User @relation(fields: [responderId], references: [id])
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model WorkTimes {
  id          Int      @id @default(autoincrement())
  userId      Int
  complaintId Int
  date        DateTime
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workerInitials String?
  customerInitials String?
  workerSignatureBase64 String?
  customerSignatureBase64 String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
}

model Buildings {
	id			Int		@id @default(autoincrement())
	buildingName	String
  emirate		String @default("dubai")
}

enum Unit {
  PIECES
  METERS
}

model Inventory {
  id                Int       @id @default(autoincrement())
  itemName          String
  itemCode          String?
  category          String?
  description       String?
  quantity          Float
  unit              Unit      @default(PIECES)
  unitPrice         Float?
  supplier          String?
  location          String?
  imageUrl          String?
  division          Division  @default(DUBAI)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  transactions      InventoryTransaction[]
  requests          InventoryRequest[]
  employeeStocks    EmployeeInventory[]        @relation("EmployeeInventoryStock")
  complaintUsages   ComplaintInventoryUsage[]  @relation("InventoryUsages")
}

enum Division {
  DUBAI
  SHARJAH
}

enum TransactionType {
  ADD
  REMOVE
  ADJUST
  REQUEST
}

enum InventoryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model InventoryTransaction {
  id                Int               @id @default(autoincrement())
  inventoryId       Int
  quantity          Float
  transactionType   TransactionType
  notes             String?
  employeeId        Int?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  
  inventory         Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  employee          User?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)
}

model InventoryRequest {
  id                Int                        @id @default(autoincrement())
  inventoryId       Int
  employeeId        Int
  quantity          Float
  status            InventoryRequestStatus    @default(PENDING)
  reason            String?
  notes             String?
  approvedBy        Int?
  approvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  inventory         Inventory                 @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  employee          User                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver          User?                     @relation("ApprovedRequests", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([inventoryId])
  @@index([status])
}

model EmployeeInventory {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  inventoryId Int
  quantity    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  User      @relation("EmployeeInventoryItems", fields: [employeeId], references: [id], onDelete: Cascade)
  inventory Inventory @relation("EmployeeInventoryStock", fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([employeeId, inventoryId])
}

// ───────────────────────── HR System ─────────────────────────

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum EarlyLeaveReason {
  SICK
  ADDITIONAL_WORK
  OTHER
}

enum EmployeeDocumentType {
  PASSPORT
  VISA
  EMIRATES_ID
  JOB_CONTRACT
  LABOUR_CARD
  OTHER
}

enum PenaltyType {
  SALARY_DEDUCTION
  LEAVE_SALARY_DEDUCTION
  TICKET_REMOVAL
}

enum PassportHandoverStatus {
  REQUESTED
  APPROVED
  HANDED_OVER
  RETURNED
  REJECTED
}

model EmployeeProfile {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  nationality           String?
  joiningDate           DateTime?
  basicSalary           Float     @default(0)
  allowances            Float     @default(0)
  workStartTime         String    @default("09:00") // "HH:mm"
  leaveSalaryOverride   Float?
  passportHeldByCompany Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id               Int               @id @default(autoincrement())
  userId           Int
  date             String // "YYYY-MM-DD" (Dubai local)
  status           AttendanceStatus
  statusOverridden Boolean           @default(false)
  arriveTime       String? // "HH:mm"
  lunchOutTime     String?
  lunchInTime      String?
  leaveTime        String?
  earlyLeaveReason EarlyLeaveReason?
  earlyLeaveNote   String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model EmployeeDocument {
  id             Int                  @id @default(autoincrement())
  userId         Int
  type           EmployeeDocumentType
  title          String? // required in UI when type == OTHER
  documentNumber String?
  fileUrl        String? // full public Supabase URL
  expiryDate     String? // "YYYY-MM-DD", typed manually
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiryDate])
}

model AirlineTicket {
  id          Int      @id @default(autoincrement())
  userId      Int
  year        Int
  destination String
  value       Float?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Penalty {
  id             Int         @id @default(autoincrement())
  userId         Int
  type           PenaltyType
  amount         Float? // null for TICKET_REMOVAL
  details        String?
  note           String?
  decidedBy      String
  date           DateTime    @default(now())
  effectiveMonth String // "YYYY-MM" — which payslip it affects
  isAutomatic    Boolean     @default(false)
  autoKey        String?     @unique // idempotency key for automatic deductions
  letterFileUrl  String? // uploaded joint-letter scan
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveMonth])
}

model Bonus {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float
  note      String?
  month     String // "YYYY-MM" payslip it applies to
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, month])
}

model PassportHandover {
  id                              Int                    @id @default(autoincrement())
  userId                          Int
  status                          PassportHandoverStatus @default(REQUESTED)
  requestReason                   String?
  requestedAt                     DateTime               @default(now())
  approvedAt                      DateTime?
  handedOverAt                    DateTime?
  returnedAt                      DateTime?
  handledByAdminName              String?
  employeeSignatureHandoverBase64 String?
  adminSignatureHandoverBase64    String?
  employeeSignatureReturnBase64   String?
  adminSignatureReturnBase64      String?
  notes                           String?
  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model ActivityLog {
  id           Int      @id @default(autoincrement())
  actorId      Int?
  targetUserId Int?
  action       String // e.g. "INVENTORY_RESTOCK", "ATTENDANCE_UPSERT"
  entityType   String // e.g. "Inventory", "AttendanceRecord"
  entityId     Int?
  details      String? // human-readable, includes name snapshots
  createdAt    DateTime @default(now())

  actor  User? @relation("ActivityLogsAuthored", fields: [actorId], references: [id], onDelete: SetNull)
  target User? @relation("ActivityLogsAbout", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

model ComplaintInventoryUsage {
  id           Int      @id @default(autoincrement())
  complaintId  Int
  employeeId   Int
  inventoryId  Int
  quantityUsed Float
  notes        String?
  createdAt    DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  employee  User      @relation("EmployeeInventoryUsages", fields: [employeeId], references: [id], onDelete: Cascade)
  inventory Inventory @relation("InventoryUsages", fields: [inventoryId], references: [id], onDelete: Cascade)
}